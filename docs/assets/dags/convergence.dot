// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Convergence workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "experiment/@enter" [label="experiment/@enter\nenter", fillcolor="#e2e8f0"];
  "experiment/@exit" [label="experiment/@exit\nexit", fillcolor="#e2e8f0"];
  "experiment/optimize/@enter" [label="experiment/optimize/@enter\nenter", fillcolor="#e2e8f0"];
  "experiment/optimize/@exit" [label="experiment/optimize/@exit\nexit", fillcolor="#e2e8f0"];
  "experiment/optimize/check_1" [label="experiment/optimize/check_1\ndecision", fillcolor="#fef3c7"];
  "experiment/optimize/check_2" [label="experiment/optimize/check_2\ndecision", fillcolor="#fef3c7"];
  "experiment/optimize/check_3" [label="experiment/optimize/check_3\ndecision", fillcolor="#fef3c7"];
  "experiment/optimize/check_4" [label="experiment/optimize/check_4\ndecision", fillcolor="#fef3c7"];
  "experiment/optimize/check_5" [label="experiment/optimize/check_5\ndecision", fillcolor="#fef3c7"];
  "experiment/optimize/check_6" [label="experiment/optimize/check_6\ndecision", fillcolor="#fef3c7"];
  "experiment/optimize/cleanup" [label="experiment/optimize/cleanup\nfinalizer", fillcolor="#dcfce7"];
  "experiment/optimize/step_1" [label="experiment/optimize/step_1\ntask", fillcolor="#dbeafe"];
  "experiment/optimize/step_2" [label="experiment/optimize/step_2\ntask", fillcolor="#dbeafe"];
  "experiment/optimize/step_3" [label="experiment/optimize/step_3\ntask", fillcolor="#dbeafe"];
  "experiment/optimize/step_4" [label="experiment/optimize/step_4\ntask", fillcolor="#dbeafe"];
  "experiment/optimize/step_5" [label="experiment/optimize/step_5\ntask", fillcolor="#dbeafe"];
  "experiment/optimize/step_6" [label="experiment/optimize/step_6\ntask", fillcolor="#dbeafe"];
  "experiment/report" [label="experiment/report\ntask", fillcolor="#dbeafe"];
  "experiment/report" -> "experiment/@exit";
  "experiment/@enter" -> "experiment/optimize/@enter";
  "experiment/optimize/cleanup" -> "experiment/optimize/@exit";
  "experiment/optimize/step_1" -> "experiment/optimize/check_1";
  "experiment/optimize/step_2" -> "experiment/optimize/check_2";
  "experiment/optimize/step_3" -> "experiment/optimize/check_3";
  "experiment/optimize/step_4" -> "experiment/optimize/check_4";
  "experiment/optimize/step_5" -> "experiment/optimize/check_5";
  "experiment/optimize/step_6" -> "experiment/optimize/check_6";
  "experiment/optimize/check_6" -> "experiment/optimize/cleanup";
  "experiment/optimize/@enter" -> "experiment/optimize/step_1";
  "experiment/optimize/check_1" -> "experiment/optimize/step_2";
  "experiment/optimize/check_2" -> "experiment/optimize/step_3";
  "experiment/optimize/check_3" -> "experiment/optimize/step_4";
  "experiment/optimize/check_4" -> "experiment/optimize/step_5";
  "experiment/optimize/check_5" -> "experiment/optimize/step_6";
  "experiment/optimize/@exit" -> "experiment/report";
}
