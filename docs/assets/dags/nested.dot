// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Nested workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "nested/@enter" [label="nested/@enter\nenter", fillcolor="#e2e8f0"];
  "nested/@exit" [label="nested/@exit\nexit", fillcolor="#e2e8f0"];
  "nested/join" [label="nested/join\ntask", fillcolor="#dbeafe"];
  "nested/left/@enter" [label="nested/left/@enter\nenter", fillcolor="#e2e8f0"];
  "nested/left/@exit" [label="nested/left/@exit\nexit", fillcolor="#e2e8f0"];
  "nested/left/first" [label="nested/left/first\ntask", fillcolor="#dbeafe"];
  "nested/left/second" [label="nested/left/second\ntask", fillcolor="#dbeafe"];
  "nested/right/@enter" [label="nested/right/@enter\nenter", fillcolor="#e2e8f0"];
  "nested/right/@exit" [label="nested/right/@exit\nexit", fillcolor="#e2e8f0"];
  "nested/right/first" [label="nested/right/first\ntask", fillcolor="#dbeafe"];
  "nested/right/second" [label="nested/right/second\ntask", fillcolor="#dbeafe"];
  "nested/seed" [label="nested/seed\ntask", fillcolor="#dbeafe"];
  "nested/join" -> "nested/@exit";
  "nested/left/@exit" -> "nested/join";
  "nested/right/@exit" -> "nested/join";
  "nested/seed" -> "nested/left/@enter";
  "nested/left/second" -> "nested/left/@exit";
  "nested/left/@enter" -> "nested/left/first";
  "nested/left/first" -> "nested/left/second";
  "nested/seed" -> "nested/right/@enter";
  "nested/right/second" -> "nested/right/@exit";
  "nested/right/@enter" -> "nested/right/first";
  "nested/right/first" -> "nested/right/second";
  "nested/@enter" -> "nested/seed";
}
