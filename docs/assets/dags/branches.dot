// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Branches workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "branches/@enter" [label="branches/@enter\nenter", fillcolor="#e2e8f0"];
  "branches/@exit" [label="branches/@exit\nexit", fillcolor="#e2e8f0"];
  "branches/choose" [label="branches/choose\ndecision", fillcolor="#fef3c7"];
  "branches/join" [label="branches/join\ntask", fillcolor="#dbeafe"];
  "branches/large" [label="branches/large\ntask · branch: large", fillcolor="#dbeafe"];
  "branches/small" [label="branches/small\ntask · branch: small", fillcolor="#dbeafe"];
  "branches/join" -> "branches/@exit";
  "branches/@enter" -> "branches/choose";
  "branches/large" -> "branches/join";
  "branches/small" -> "branches/join";
  "branches/choose" -> "branches/large";
  "branches/choose" -> "branches/small";
}
