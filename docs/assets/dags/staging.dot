// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Staging workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "staging/@enter" [label="staging/@enter\nenter", fillcolor="#e2e8f0"];
  "staging/@exit" [label="staging/@exit\nexit", fillcolor="#e2e8f0"];
  "staging/summarize" [label="staging/summarize\ntask", fillcolor="#dbeafe"];
  "staging/summarize" -> "staging/@exit";
  "staging/@enter" -> "staging/summarize";
}
