// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Command workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "command/@enter" [label="command/@enter\nenter", fillcolor="#e2e8f0"];
  "command/@exit" [label="command/@exit\nexit", fillcolor="#e2e8f0"];
  "command/write" [label="command/write\ntask", fillcolor="#dbeafe"];
  "command/write" -> "command/@exit";
  "command/@enter" -> "command/write";
}
