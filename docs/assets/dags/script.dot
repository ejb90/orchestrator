// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Script workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "script_example/@enter" [label="script_example/@enter\nenter", fillcolor="#e2e8f0"];
  "script_example/@exit" [label="script_example/@exit\nexit", fillcolor="#e2e8f0"];
  "script_example/report" [label="script_example/report\ntask", fillcolor="#dbeafe"];
  "script_example/report" -> "script_example/@exit";
  "script_example/@enter" -> "script_example/report";
}
