// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Sensor_Report workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "sensor_report/@enter" [label="sensor_report/@enter\nenter", fillcolor="#e2e8f0"];
  "sensor_report/@exit" [label="sensor_report/@exit\nexit", fillcolor="#e2e8f0"];
  "sensor_report/clean" [label="sensor_report/clean\ntask", fillcolor="#dbeafe"];
  "sensor_report/report" [label="sensor_report/report\ntask", fillcolor="#dbeafe"];
  "sensor_report/report" -> "sensor_report/@exit";
  "sensor_report/@enter" -> "sensor_report/clean";
  "sensor_report/clean" -> "sensor_report/report";
}
