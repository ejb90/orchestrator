// Generated by scripts/generate_dags.py; visualization-only transitive reduction.
// Guards, early completion, and finalizers remain coordinator-controlled.
digraph workflow {
  graph [rankdir=TB, label="Diamond workflow", labelloc=t, fontname=Helvetica];
  node [shape=box, style="rounded,filled", fontname=Helvetica, color="#64748b"];
  edge [color="#64748b"];
  "diamond/@enter" [label="diamond/@enter\nenter", fillcolor="#e2e8f0"];
  "diamond/@exit" [label="diamond/@exit\nexit", fillcolor="#e2e8f0"];
  "diamond/join" [label="diamond/join\ntask", fillcolor="#dbeafe"];
  "diamond/left" [label="diamond/left\ntask", fillcolor="#dbeafe"];
  "diamond/right" [label="diamond/right\ntask", fillcolor="#dbeafe"];
  "diamond/seed" [label="diamond/seed\ntask", fillcolor="#dbeafe"];
  "diamond/join" -> "diamond/@exit";
  "diamond/left" -> "diamond/join";
  "diamond/right" -> "diamond/join";
  "diamond/seed" -> "diamond/left";
  "diamond/seed" -> "diamond/right";
  "diamond/@enter" -> "diamond/seed";
}
